# The sdist ships the test suite (setuptools picks up tests/test*.py on its own),
# so it has to ship everything that suite imports or reads:
#   - conftest.py and the shared fakes the terminal and MCP tests drive
#   - probes/: the captured generator replies test_json_repair reads by path
# Without this the tarball carried 39 test modules that could not be collected,
# plus two that failed on a missing fixture. Found by unpacking the release and
# running it -- which is now a job in ci.yml, and was briefly a job in
# tool-market's reproduce workflow before it moved to the repo that can fix it.
recursive-include tests *.py
recursive-include probes *.txt *.md *.py

# The sdist's own suite drives two things that are not importable modules:
# `tools/media_mcp_server.py` (spawned as a script by the MCP tests) and the
# vendored tars tree (read as data, with its licence and hash manifest). Neither
# is a package, so setuptools carried neither, and the unpacked-sdist job kept
# failing on files that exist in every checkout.
recursive-include tools *.py
recursive-include autoforge/vendor *.py *.txt *.md *.sha256
# The tars skills are `SKILL.md`, and `graft`-style extension globs cannot say
# "every file under here". Named explicitly so an upstream rename is a test
# failure rather than a silently thinner tarball.
recursive-include autoforge/vendor/tars/skill_system/skills *
recursive-include autoforge/vendor LICENSE
