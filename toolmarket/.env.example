# Credentials for `docker compose`. Copy to `.env` and change what matters.
#
#   cp .env.example .env && docker compose up -d
#
# `.env` is gitignored; this file is not. The defaults here are the same obvious
# throwaways the compose file falls back to, and they are deliberately published:
# a stack that runs with a documented password cannot be mistaken for one that is
# secure, whereas a "changeme" that never gets changed is a credential nobody
# knows is a credential.

# -- postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=toolmarket-local

# -- ports ------------------------------------------------------------------
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=toolmarket-local

# -- tuning (optional; compose sets these already) --------------------------
# Writes per window, per client. The limiter is in-process, so N replicas allow
# N x this — see toolmarket/ratelimit.py, which says so where it matters.
RATE_LIMIT=120
RATE_LIMIT_WINDOW=60
# Seconds. 0 disables the read cache entirely.
CACHE_TTL=30
