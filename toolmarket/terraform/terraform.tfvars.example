# Copy to terraform.tfvars and edit. Every value here is also the default, so an
# empty tfvars and no tfvars behave the same — this file exists to show what is
# adjustable, not to be required.
#
# api_port          = 8000
# task_queue        = "celery"   # or "inline" (no worker container)
# stack_name        = "toolmarket-tf"
# redis_maxmemory   = "128mb"
# app_image_tag     = "toolmarket:tf"
#
# Override this for anything reachable from off the host. The default is a
# throwaway local credential and is named to look like one.
# postgres_password = "toolmarket"
